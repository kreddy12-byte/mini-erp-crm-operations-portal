# Copy this file to `.env` in the repository root for Docker Compose.
#   copy .env.docker.example .env
# Never commit `.env`. Values below are for local Docker only.

# PostgreSQL (container + DATABASE_URL host = postgres service name)
POSTGRES_DB=mini_erp_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host publish only. If local PostgreSQL already uses 5432, set e.g. 5433.
# Containers always talk to postgres:5432 on the Compose network.
POSTGRES_PORT=5432

# Published host ports
BACKEND_PORT=4000
FRONTEND_PORT=8080

# Browser-facing URLs (localhost = host machine, not Docker DNS)
FRONTEND_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:4000/api
ALLOW_LOCALHOST_FRONTEND_URL=true

# Required. Must be unique, >= 32 characters, and not the Phase 9 example placeholder.
# Generate your own for anything beyond local Compose.
JWT_SECRET=docker-local-dev-jwt-secret-min-32-chars
JWT_EXPIRES_IN=1d

# Optional email / Google (leave empty locally if unused)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
