# Copy frontend/.env.example and backend/.env.example into
# frontend/.env and backend/.env for local development.
# This root file documents the split; do not put secrets here.

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api

# Backend
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Future phases (not used in Phase 1)
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=1d
