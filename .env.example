# Copy frontend/.env.example and backend/.env.example into
# frontend/.env and backend/.env for local development.
# This root file documents the split; do not put secrets here.

# Frontend (Vite — only VITE_* values are exposed to the browser bundle)
VITE_API_BASE_URL=http://localhost:4000/api
VITE_GOOGLE_CLIENT_ID=

# Backend
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_erp_crm?schema=public

# Authentication. Do not put real secrets in this example file.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Email (verification + password reset)
EMAIL_FROM="Operations Portal <noreply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Google Identity Services
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed guard (production only). Leave unset; never enable casually.
# ALLOW_PROD_SEED=
