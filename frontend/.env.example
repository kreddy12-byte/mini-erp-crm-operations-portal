# Axios base URL including the /api prefix.
# Local Vite: this value is used by Axios; Vite also proxies /api to the backend.
# Production (Vercel/Netlify): set this at build time to your deployed API, e.g.
#   https://your-api.example.com/api
# Do not hardcode localhost in a production build.
VITE_API_BASE_URL=http://localhost:4000/api

# Google Identity Services client ID (same OAuth client as backend GOOGLE_CLIENT_ID).
# Leave empty locally if Google sign-in is not configured; the UI will fail clearly.
VITE_GOOGLE_CLIENT_ID=
