PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Local PostgreSQL. Matches docker-compose.yml.
# Do not commit real production credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_erp_crm?schema=public

# Authentication. Generate a unique JWT_SECRET for every environment.
# Do not use the example value in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Email delivery (verification + password reset). Required for signup and reset emails.
# Local development: Mailpit/Mailhog on localhost:1025, or any SMTP inbox.
EMAIL_FROM="Operations Portal <noreply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Google Identity Services. Backend verifies ID tokens with GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_SECRET is reserved for the Google Cloud client and must not be committed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
